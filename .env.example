# Copia este archivo como .env.development o .env.production y ajusta los valores.
# Todas son opcionales: sin .env el kiosko arranca con valores por defecto (así corre la demo pública).

# Página que abre el teléfono del cliente al escanear el QR del kiosko.
# Por defecto es este mismo sitio en /phone; en producción debe ser una URL accesible desde el móvil.
VITE_PHONE_URL=https://kiosk.tu-negocio.com/phone

# Servidor Socket.IO que une kiosko y teléfono (carpeta server/). Vacío = mismo origen.
# En desarrollo Vite lo proxea a http://127.0.0.1:4000, así que puede quedar vacío.
VITE_REALTIME_URL=

# Servicio local de impresión térmica (solo modo pago). Recibe POST { image: <png en base64> }.
VITE_PRINTER_URL=http://127.0.0.1:5000/print
