# Copia este archivo como .env.development o .env.production y ajusta los valores.

# API que recibe el pedido y confirma el pago (servidor propio del negocio).
VITE_API_URL=http://localhost:4000

# development | production
VITE_ENV=development

# Página que abre el teléfono del cliente al escanear el QR del kiosko: el formulario de datos y pago.
# Normalmente es este mismo sitio con la ruta /form, publicado en una URL accesible desde el móvil.
VITE_QR_BASE_URL=http://localhost:5173/form
