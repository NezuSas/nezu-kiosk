# Copia este archivo como .env junto a docker-compose.yml y rellena al menos PUBLIC_URL y ADMIN_TOKEN.

# URL pública donde queda el kiosko (sin barra final). El QR del tótem lleva al cliente a PUBLIC_URL/phone, así que
# debe ser alcanzable desde la red móvil: normalmente un túnel de Cloudflare o un dominio con HTTPS.
PUBLIC_URL=https://kiosk.tu-negocio.com

# Puerto del equipo que expone el contenedor (dentro siempre es 4000).
PORT=4000

# Token de la página de administración (/admin), de la confirmación de pagos y de las estadísticas. Largo y aleatorio.
ADMIN_TOKEN=cambia-este-token

# Orígenes permitidos. En producción, la URL pública; «*» solo para probar.
CORS_ORIGIN=https://kiosk.tu-negocio.com

# Nombre del negocio en el asunto de los correos.
BUSINESS_NAME=NEZU

# Entrega de solicitudes por correo (deja vacío para no usarla).
SMTP_URL=smtps://usuario:clave@smtp.tu-proveedor.com:465
LEADS_EMAIL_TO=ventas@tu-negocio.com
LEADS_EMAIL_FROM=kiosko@tu-negocio.com

# Entrega de solicitudes por webhook (CRM, hoja de cálculo, automatización). Deja vacío para no usarla.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Minutos sin actividad antes de olvidar una sesión del tótem.
SESSION_TTL_MINUTES=60
